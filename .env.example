# --- Supabase (Postgres) ---
# Supabase ダッシュボード > Connect > ORMs (Prisma) からコピー
# DATABASE_URL: Transaction pooler (ポート 6543, pgbouncer) — アプリ実行時に使用
# DIRECT_URL:   Direct connection (ポート 5432) — prisma migrate 時に使用
DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres"

# --- NextAuth (Auth.js) ---
# 生成コマンド: openssl rand -base64 32
AUTH_SECRET=""
# 本番では公開 URL を設定 (例: https://your-app.vercel.app)
AUTH_URL="http://localhost:3000"

# --- Resend (メール送信) ---
# https://resend.com/api-keys で取得
RESEND_API_KEY=""
# 独自ドメインを Resend に登録済みならその送信元アドレス。未登録なら onboarding@resend.dev のまま
EMAIL_FROM="onboarding@resend.dev"

# --- Vercel Cron 認証 ---
# 生成コマンド: openssl rand -hex 32
# Vercel の環境変数に CRON_SECRET を設定すると、Cron 呼び出し時に自動で Authorization ヘッダーが付与される
CRON_SECRET=""
